{
  "name": "bunker",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental hash-authorized Solana custody. Mainnet custody remains disabled pending independent review.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plantsweb3/bunker.git"
  },
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --port 5173",
    "build": "next build --webpack",
    "start": "next start --port 5173",
    "lint": "eslint app components/bunker sdk lib tests scripts tools",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:chain": "tsx tests/chain-v3.ts",
    "program:build": "cargo-build-sbf --manifest-path programs/bunker3/Cargo.toml --sbf-out-dir target/deploy",
    "setup:local": "tsx scripts/setup-local.ts",
    "source:bundle": "node scripts/bundle-source.mjs && node scripts/build-recovery-tool.mjs",
    "tool:build": "node scripts/build-recovery-tool.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@noble/hashes": "1.8.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.4.0",
    "@solana/web3.js": "1.99.0",
    "@wallet-standard/app": "1.1.0",
    "buffer": "6.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.4.0",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "jayson": "5.0.0",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "baseline-browser-mapping": "2.11.0",
    "ws": "8.22.0"
  }
}
