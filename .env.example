# Server-side dedicated RPC for production. Never expose to browser.
# SOLANA_RPC_URL=https://your-provider.example/your-secret-key
# The public release uses Solana mainnet and the one published program: leave test settings unset.
# For local test configuration run npm run setup:local after starting local-validator.sh.
# BUNKER_ENABLE_TEST_CUSTODY=true
# BUNKER_TEST_NETWORK=localnet
# BUNKER_TEST_RPC_URL=http://127.0.0.1:19099
# BUNKER_TEST_PROGRAM_ID=k7FaK87WHGVXzkaoHb7CdVPgkKDQhZ29VLDeBVbDfYn
# BUNKER_LOCAL_GENESIS=<generated-by-setup-local>
# Public addresses the site shows after launch. They can be set ahead of time: nothing is
# shown until BUNKER_LAUNCH_LIVE=true. Unset or malformed: the site says "not published yet".
# BUNKER_COIN_ADDRESS=
# BOUNTY_WALLET_ADDRESS=
# BUNKER_LAUNCH_LIVE=true
# Optional Telegram alerts. All six are required; see docs/DEPLOYMENT.md.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# CRON_SECRET=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
